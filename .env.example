DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
SEED_PASSWORD="replace-with-a-strong-password-12-chars-min"
SUPER_ADMIN_EMAIL="replace-with-super-admin-email"
SUPER_ADMIN_NAME="replace-with-super-admin-name"
SUPER_ADMIN_PASSWORD="replace-with-super-admin-password-12-chars-min"
