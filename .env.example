DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
SEED_PASSWORD="replace-with-a-strong-password-12-chars-min"
SUPER_ADMIN_EMAIL="replace-with-super-admin-email"
SUPER_ADMIN_NAME="replace-with-super-admin-name"
SUPER_ADMIN_PASSWORD="replace-with-super-admin-password-12-chars-min"
# Optional when the public request origin cannot be reliably derived; must be an HTTPS origin.
PUBLIC_APP_URL="https://your-domain.example"
# Required only when using POST /api/internal/rerent/process or the persistent Re-Rent worker.
RERENT_SCHEDULER_SECRET="replace-with-at-least-32-random-bytes"
